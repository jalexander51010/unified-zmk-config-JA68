#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <4>;

        /*
         * Full 5x4 logical matrix.
         * Use &none in the keymap for spots that do not have a physical switch.
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
        >;
    };

  kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        /* If standard active-high doesn't work, change this to "row2col" */
        diode-direction = "col2row";

        /* Rows R0-R4: inputs with pull-downs */
        row-gpios = <
            &gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
            &gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
            &gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
            &gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
            &gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
        >;

        /* Columns C0-C3: driven outputs */
        col-gpios = <
            &gpio0 24 GPIO_ACTIVE_HIGH
            &gpio1 0  GPIO_ACTIVE_HIGH
            &gpio0 11 GPIO_ACTIVE_HIGH
            &gpio1 4  GPIO_ACTIVE_HIGH
        >;
    };
};

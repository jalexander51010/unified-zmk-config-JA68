#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

       /* * Edited
         */

/ {
  keymap {
    compatible = "zmk,keymap";

    /* Layer 0: Normal numpad */
    default_layer {
      bindings = <
        /* Row 0 */
        &lt 1 &kp KP_NUMLOCK   &kp KP_DIVIDE   &kp KP_MULTIPLY   &kp KP_MINUS

        /* Row 1 */
        &kp KP_7              &kp KP_8        &kp KP_9          &kp KP_PLUS

        /* Row 2  (+ is 2u; this cell is empty) */
        &kp KP_4              &kp KP_5        &kp KP_6          &none

        /* Row 3 */
        &kp KP_1              &kp KP_2        &kp KP_3          &kp KP_ENTER

        /* Row 4  (0 is 2u; Enter is 2u; extra cells empty) */
        &kp KP_0              &none           &kp KP_DOT        &none
      >;
    };

    /* Layer 1: Fn (hold NumLock) */
    fn_layer {
      bindings = <
        /* Row 0: / * - */
        &trans               &sys_reset        &bootloader       &kp C_VOLUME_DOWN

        /* Row 1: 7 8 9 + */
        &kp C_PREV           &kp C_PLAY_PAUSE  &kp C_NEXT        &kp C_VOLUME_UP

        /* Row 2: 4 5 6 (empty) */
        &bt BT_SEL 3         &bt BT_SEL 4      &bt BT_NXT        &none

        /* Row 3: 1 2 3 Enter */
        &bt BT_SEL 0         &bt BT_SEL 1      &bt BT_SEL 2      &none

        /* Row 4: 0 (empty) . (empty) */
        &kp C_MUTE           &none             &bt BT_CLR        &kp C_PLAY_PAUSE
      >;
    };
  };
};
